# Server-only HTTPS API Gateway endpoint, including the /xavier route.
# Set from the existing PlannedOut-Xavier-API in ap-southeast-2.
# Authentication uses the signed-in user's Supabase JWT; no AWS keys are needed.
XAVIER_AWS_API_URL=

# Server-only HTTPS API Gateway endpoint, including the /voice route.
# Do not expose the EC2 private address, Lambda URL, or any AWS credential to the browser.
XAVIER_VOICE_API_URL=

# Server-only vision provider: azure (default), openai-compatible, or local-gateway.
# Keep both values private. Do not create NEXT_PUBLIC vision backend variables.
XAVIER_VISION_PROVIDER=azure
XAVIER_VISION_ENDPOINT=
# Legacy endpoint alias remains supported.
XAVIER_VISION_API_URL=
XAVIER_VISION_API_KEY=
XAVIER_VISION_MODEL=Qwen/Qwen3-VL-2B-Instruct

# Stripe-hosted Payment Links and email-authenticated customer portal.
# The webhook signing secret lives only in AWS Secrets Manager.
STRIPE_PAYMENT_LINK_PRO_MONTHLY=
STRIPE_PAYMENT_LINK_PRO_YEARLY=
STRIPE_PAYMENT_LINK_BUSINESS_MONTHLY=
STRIPE_PAYMENT_LINK_BUSINESS_YEARLY=
STRIPE_CUSTOMER_PORTAL_URL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# Xavier agent task service. Keep worker tokens private and server-only.
# Azure App Service can persist the queue under /home on the existing single instance.
XAVIER_AGENT_DB=
XAVIER_AGENT_WINDOWS_TOKEN=
XAVIER_AGENT_CLOUD_TOKEN=
XAVIER_AZURE_BACKEND_URL=
