PUSH_CONTACT_EMAIL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
RESEND_API_KEY=
INVITE_EMAIL_FROM=

# Server-only HTTPS API Gateway endpoint, including the /xavier route.
# Set from the existing PlannedOut-Xavier-API in ap-southeast-2.
# Authentication uses the signed-in user's Supabase JWT; no AWS keys are needed.
XAVIER_AWS_API_URL=

# Stripe-hosted Payment Links and email-authenticated customer portal.
# The webhook signing secret lives only in AWS Secrets Manager.
STRIPE_PAYMENT_LINK_PRO_MONTHLY=
STRIPE_PAYMENT_LINK_PRO_YEARLY=
STRIPE_PAYMENT_LINK_BUSINESS_MONTHLY=
STRIPE_PAYMENT_LINK_BUSINESS_YEARLY=
STRIPE_CUSTOMER_PORTAL_URL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# Production CosyVoice on Valebyte: server-only HTTPS endpoint ending in /tts.
# Set the separate trusted origin only after verifying its DNS/server ownership.
# Never use the Surface, a LAN address, or a workstation tunnel as the backend.
XAVIER_TTS_URL=
XAVIER_TTS_TRUSTED_ORIGIN=

# Optional local Xavier voice server (development only; ignored in production).
# Example for this PC on the current Wi-Fi: http://192.168.1.11:5173
NEXT_PUBLIC_TTS_SERVER_URL=
NEXT_PUBLIC_TTS_LANGUAGE=en
NEXT_PUBLIC_TTS_STYLE=You are Xavier, an intelligent personal AI assistant. Speak in a deep, calm, warm, confident, natural conversational voice with measured pacing, clear pauses between ideas, gentle warmth, subtle emotional expression, and a slightly mysterious intelligent presence. Never shout, overact, or sound like a radio announcer.
NEXT_PUBLIC_TTS_SPEAKER=xavier_warm

# Production CosyVoice 3 (server-side proxy).
NEXT_PUBLIC_TTS_MODE=
COSYVOICE_API_URL=
COSYVOICE_API_KEY=
COSYVOICE_LANGUAGE=en
COSYVOICE_SPEAKER=xavier_warm

# Private CosyVoice reference WAV path for cloud/operator setup. Do not commit the recording itself.
XAVIER_COSYVOICE_PROMPT_WAV=
XAVIER_COSYVOICE_STYLE=You are Xavier, an intelligent personal AI assistant. Speak in a deep, calm, warm, confident, natural conversational voice with measured pacing, clear pauses between ideas, gentle warmth, subtle emotional expression, and a slightly mysterious intelligent presence. Never shout, overact, or sound like a radio announcer.
